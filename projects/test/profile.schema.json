{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Profil",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "email", "age", "active"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "age": {
      "type": "integer",
      "minimum": 0,
      "maximum": 150
    },
    "active": {
      "type": "boolean"
    }
  }
}
